{
  "$defs": {
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "start_char",
        "end_char",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "Qualifier": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "REGION",
            "CONFIGURATION",
            "VERSION",
            "LIMITATION",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Qualifier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "minLength": 1,
      "title": "Assertion Id",
      "type": "string"
    },
    "chunk_id": {
      "minLength": 1,
      "title": "Chunk Id",
      "type": "string"
    },
    "document_version_id": {
      "minLength": 1,
      "title": "Document Version Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceSpan"
    },
    "extraction_model_id": {
      "minLength": 1,
      "title": "Extraction Model Id",
      "type": "string"
    },
    "extraction_prompt_version": {
      "minLength": 1,
      "title": "Extraction Prompt Version",
      "type": "string"
    },
    "extraction_recipe_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Extraction Recipe Sha256",
      "type": "string"
    },
    "object_id": {
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "ontology_version": {
      "minLength": 1,
      "title": "Ontology Version",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "POSITIVE",
        "NEGATIVE"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "predicate": {
      "enum": [
        "INTEGRATES_WITH",
        "DEPENDS_ON",
        "PART_OF",
        "SUPPORTS",
        "USES",
        "REPLACES"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "qualifiers": {
      "items": {
        "$ref": "#/$defs/Qualifier"
      },
      "title": "Qualifiers",
      "type": "array"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "assertion_id",
    "tenant_id",
    "subject_id",
    "predicate",
    "object_id",
    "chunk_id",
    "document_version_id",
    "evidence",
    "polarity",
    "qualifiers",
    "ontology_version",
    "extraction_prompt_version",
    "extraction_model_id",
    "extraction_recipe_sha256"
  ],
  "title": "RelationAssertion",
  "type": "object"
}
