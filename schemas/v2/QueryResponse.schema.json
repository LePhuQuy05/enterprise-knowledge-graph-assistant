{
  "$defs": {
    "AnswerAssessment": {
      "additionalProperties": false,
      "description": "Public-source workflow boundary; reported limitations are not verified facts.",
      "properties": {
        "account_state_access": {
          "const": "NOT_CONNECTED",
          "default": "NOT_CONNECTED",
          "title": "Account State Access",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnswerLimitation"
          },
          "maxItems": 3,
          "title": "Limitations",
          "type": "array"
        },
        "policy_origin": {
          "const": "SYSTEM_POLICY",
          "default": "SYSTEM_POLICY",
          "title": "Policy Origin",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_scope": {
          "const": "SUPPLIED_DOCUMENTATION_ONLY",
          "default": "SUPPLIED_DOCUMENTATION_ONLY",
          "title": "Source Scope",
          "type": "string"
        }
      },
      "title": "AnswerAssessment",
      "type": "object"
    },
    "AnswerLimitation": {
      "additionalProperties": false,
      "description": "Reported uncertainty or a system boundary, separate from cited AWS facts.",
      "properties": {
        "code": {
          "enum": [
            "MISSING_SUPPLIED_EVIDENCE",
            "ACCOUNT_STATE_UNAVAILABLE",
            "SOURCE_SCOPE_AMBIGUITY",
            "CONFLICTING_SUPPLIED_EVIDENCE",
            "OUT_OF_SCOPE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "next_step": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Next Step",
          "type": "string"
        },
        "question_part": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Part"
        },
        "reported_by": {
          "enum": [
            "MODEL_REPORTED",
            "SYSTEM_POLICY"
          ],
          "title": "Reported By",
          "type": "string"
        }
      },
      "required": [
        "code",
        "reported_by",
        "message",
        "next_step"
      ],
      "title": "AnswerLimitation",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "citation_id": {
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "document_version_id": {
          "minLength": 1,
          "title": "Document Version Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "section_path": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "chunk_id",
        "document_version_id",
        "title",
        "source_uri",
        "section_path",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "citation_ids"
      ],
      "title": "Claim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "answer_language": {
      "default": "en",
      "enum": [
        "en",
        "vi"
      ],
      "title": "Answer Language",
      "type": "string"
    },
    "answer_status": {
      "enum": [
        "ANSWERED",
        "PARTIAL",
        "ABSTAINED"
      ],
      "title": "Answer Status",
      "type": "string"
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence_bundle_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Bundle Sha256"
    },
    "mode_requested": {
      "enum": [
        "bm25",
        "vector",
        "hybrid",
        "hybrid_reranked",
        "hybrid_multi_query",
        "hybrid_multi_query_balanced",
        "graph_1hop",
        "graph_2hop"
      ],
      "title": "Mode Requested",
      "type": "string"
    },
    "mode_used": {
      "enum": [
        "bm25",
        "vector",
        "hybrid",
        "hybrid_reranked",
        "hybrid_multi_query",
        "hybrid_multi_query_balanced",
        "graph_1hop",
        "graph_2hop"
      ],
      "title": "Mode Used",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "retrieval_backend": {
      "default": "snapshot_numpy_adjacency",
      "enum": [
        "snapshot_numpy_adjacency",
        "aws_knowledge_mcp",
        "collection_numpy_global_bm25"
      ],
      "title": "Retrieval Backend",
      "type": "string"
    },
    "snapshot_version": {
      "minLength": 1,
      "title": "Snapshot Version",
      "type": "string"
    },
    "used_graph": {
      "title": "Used Graph",
      "type": "boolean"
    },
    "warnings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "answer",
    "claims",
    "citations",
    "answer_status",
    "mode_requested",
    "mode_used",
    "used_graph",
    "snapshot_version"
  ],
  "title": "QueryResponse",
  "type": "object"
}
