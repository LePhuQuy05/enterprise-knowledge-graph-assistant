* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.ps1 text eol=crlf

# Preserve byte hashes of frozen evaluation inputs and receipts on every platform.
configs/evaluation/expanded-development-*-v1.json -text whitespace=cr-at-eol
benchmarks/expanded-development-v1/** -text whitespace=cr-at-eol

# These files are byte-pinned to the deployed V2 worker (including CRLF).
app/document_recall_v2.py -text whitespace=cr-at-eol
app/faceted_query_v5.py -text whitespace=cr-at-eol
app/semantic_extraction_cache_v10.py -text whitespace=cr-at-eol
app/semantic_extraction_cache_v7.py -text whitespace=cr-at-eol
app/semantic_extraction_cache_v9.py -text whitespace=cr-at-eol
app/source_graph_jobs_v10.py -text whitespace=cr-at-eol
